---
import { contact, whatsappLink } from '../config/site';
import { getLang, ui } from '../i18n/ui';
import TechLogo from './TechLogo.astro';

type Row = { label: string; value: string; href: string; external: boolean; icon?: string };

const rows: Row[] = [
  {
    label: 'WhatsApp',
    value: contact.whatsappDisplay,
    href: whatsappLink(ui[getLang(Astro.currentLocale)].generalMessage),
    external: true,
  },
  {
    label: 'Mail',
    value: contact.email,
    href: `mailto:${contact.email}`,
    external: false,
    icon: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/>',
  },
  {
    label: 'GitHub',
    value: contact.github.replace('https://', ''),
    href: contact.github,
    external: true,
  },
];

// LinkedIn solo aparece si está cargado en src/config/site.ts.
if (contact.linkedin) {
  rows.push({
    label: 'LinkedIn',
    value: contact.linkedin.replace('https://', ''),
    href: contact.linkedin,
    external: true,
  });
}
---

<ul class="grid gap-4 sm:grid-cols-2" data-reveal-stagger>
  {
    rows.map((row) => (
      <li>
        <a
          href={row.href}
          target={row.external ? '_blank' : undefined}
          rel={row.external ? 'noopener noreferrer' : undefined}
          class="glass glow-edge group flex items-center gap-4 rounded-3xl p-4 transition-transform duration-300 hover:-translate-y-1"
        >
          <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-surface-2 ring-1 ring-line transition-transform duration-300 group-hover:scale-110">
            {row.icon ? (
              <svg
                viewBox="0 0 24 24"
                width="22"
                height="22"
                fill="none"
                stroke="var(--color-accent)"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={row.icon}
              />
            ) : (
              <TechLogo name={row.label} size={22} />
            )}
          </span>
          <span class="min-w-0 flex-1">
            <span class="block font-display text-[1.0625rem] text-text transition-colors group-hover:text-accent">
              {row.label}
            </span>
            <span class="block truncate text-sm text-muted">{row.value}</span>
          </span>
          <svg
            class="shrink-0 text-muted transition-all duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent"
            viewBox="0 0 16 16"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 12 12 4M5.5 4H12v6.5" />
          </svg>
        </a>
      </li>
    ))
  }
</ul>
