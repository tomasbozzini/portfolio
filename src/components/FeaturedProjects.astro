---
import type { Project } from '../lib/projects';
import { projectHref } from '../lib/projects';
import ProjectCover from './ProjectCover.astro';
import StackTags from './StackTags.astro';
import ProjectEmblem from './ProjectEmblem.astro';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<!-- Tarjetas horizontales: portada a la izquierda, texto a la derecha. Dos por fila en pantallas grandes. -->
<div class="grid gap-6 lg:grid-cols-2" data-reveal-stagger>
  {
    projects.map((project, index) => (
      <div>
        <a
          href={projectHref(project.data.slug, project.lang)}
          class="floaty glass glow-edge group flex h-full flex-col gap-2 rounded-3xl p-2.5 sm:flex-row"
        >
          <div class="relative aspect-16/10 shrink-0 overflow-hidden rounded-[1.1rem] bg-surface sm:aspect-auto sm:min-h-56 sm:w-[42%]">
            {/* Con emblema y sin captura propia, el fondo va liso: solo el logo, sin el patrón generado. */}
            {(project.data.cover || !project.data.emblem) && (
              <div class="h-full w-full transition-transform duration-700 ease-out group-hover:scale-[1.06] sm:absolute sm:inset-0">
                <ProjectCover
                  cover={project.data.cover}
                  title={project.data.title}
                  category={project.data.category}
                  slug={project.data.slug}
                  sizes="(min-width: 1024px) 15rem, (min-width: 640px) 40vw, 100vw"
                  eager={index < 2}
                  instance="destacado"
                />
              </div>
            )}
            {/* Con imagen propia, el emblema no se muestra. */}
            {!project.data.cover && <ProjectEmblem emblem={project.data.emblem} />}
          </div>

          <div class="flex flex-1 flex-col px-2.5 pt-4 pb-3 sm:py-3 sm:pr-3 sm:pl-3.5">
            <div class="flex flex-wrap items-center gap-2">
              <span class="rounded-full bg-cafe/15 px-2.5 py-1 text-[0.7rem] leading-none text-accent-2 ring-1 ring-cafe/30">
                {project.categoryLabel}
              </span>
              {project.data.status && (
                <span class="rounded-full bg-accent/10 px-2.5 py-1 text-[0.7rem] leading-none text-accent ring-1 ring-accent/25">
                  {project.data.status}
                </span>
              )}
            </div>

            <h3 class="mt-3 font-display text-[1.125rem] leading-tight text-text transition-colors group-hover:text-accent">
              {project.data.title}
            </h3>

            <p class="mt-2 line-clamp-3 flex-1 text-[0.875rem] leading-relaxed text-muted">
              {project.data.summary}
            </p>

            <div class="mt-5">
              <StackTags items={project.data.stack} limit={3} />
            </div>
          </div>
        </a>
      </div>
    ))
  }
</div>
