---
import { site } from '../config/site';
import { getLang, ui } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = ui[lang];
---

<section class="shell relative pt-20 pb-20 sm:pt-28 lg:pt-36 lg:pb-28">
  <p
    class="rise inline-flex items-center gap-2.5 rounded-full border border-line bg-surface/60 py-1.5 pr-4 pl-2.5 font-mono text-[0.72rem] tracking-wider text-muted backdrop-blur"
    style="animation-delay: 0ms"
  >
    <span class="pulse-dot size-2 rounded-full bg-accent"></span>
    {t.hero.available} · {site.location.split(',')[0]}
  </p>

  <h1
    class="rise mt-7 font-display text-display font-bold text-gradient"
    style="animation-delay: 100ms"
  >
    {site.name}
  </h1>

  <div
    class="draw mt-7 h-[2px] w-full max-w-[34rem] rounded-full bg-gradient-to-r from-accent via-cafe to-transparent"
    style="animation-delay: 260ms"
    aria-hidden="true"
  >
  </div>

  <p
    class="rise measure mt-6 font-ui text-lg text-muted sm:text-xl"
    style="animation-delay: 380ms"
  >
    {t.role}
  </p>

  <div
    class="rise mt-10 flex flex-wrap items-center gap-4"
    style="animation-delay: 500ms"
  >
    <a href="#proyectos" class="btn-primary">
      {t.hero.seeProjects}
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M8 3v10M3.5 8.5 8 13l4.5-4.5"/></svg>
    </a>

    <a href="#contacto" class="btn-ghost">{t.hero.contact}</a>
  </div>

  <!-- Órbitas decorativas -->
  <div
    class="rise pointer-events-none absolute top-16 right-0 -z-10 hidden size-[26rem] lg:block"
    style="animation-delay: 600ms"
    aria-hidden="true"
  >
    <div class="absolute inset-0 rounded-full border border-line/70"></div>
    <div class="absolute inset-12 rounded-full border border-line/60"></div>
    <div class="absolute inset-24 rounded-full border border-accent/20 bg-gradient-to-br from-accent/10 to-accent-2/10 blur-[1px]"></div>
    <div class="orbit absolute inset-0">
      <span class="absolute top-1/2 -left-1.5 size-3 rounded-full bg-accent shadow-[0_0_20px_var(--color-accent)]"></span>
    </div>
    <div class="orbit orbit-slow absolute inset-12">
      <span class="absolute -top-1 left-1/2 size-2 rounded-full bg-accent-2 shadow-[0_0_16px_var(--color-accent-2)]"></span>
    </div>
  </div>
</section>

<style>
  .orbit {
    animation: spin 18s linear infinite;
  }
  .orbit-slow {
    animation-duration: 28s;
    animation-direction: reverse;
  }
</style>
