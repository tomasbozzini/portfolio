---
import { whatsappLink } from '../config/site';
import { getLang, ui } from '../i18n/ui';

const t = ui[getLang(Astro.currentLocale)];
const services = t.services;

// Un ícono por servicio, en el mismo orden que en src/i18n/ui.ts.
const icons = [
  '<rect x="3" y="4" width="18" height="16" rx="3"/><path d="M3 9h18M7 6.5h.01M10 6.5h.01"/>',
  '<rect x="4" y="4" width="7" height="7" rx="2"/><rect x="13" y="4" width="7" height="7" rx="2"/><rect x="4" y="13" width="7" height="7" rx="2"/><path d="M16.5 13.5v6M13.5 16.5h6"/>',
  '<path d="M12 3.5 13.9 9 19.5 11 13.9 13 12 18.5 10.1 13 4.5 11 10.1 9z"/><path d="M18.5 3v3.5M16.75 4.75h3.5"/>',
];
---

<div class="grid gap-6 md:grid-cols-3" data-reveal-stagger>
  {
    services.map((service, index) => (
      <div>
        <article class="floaty glass glow-edge flex h-full flex-col rounded-3xl p-6 lg:p-7">
          <span class="grid size-11 place-items-center rounded-2xl bg-gradient-to-br from-accent/20 to-accent-2/25 text-accent ring-1 ring-accent/30">
            <svg
              viewBox="0 0 24 24"
              width="22"
              height="22"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={icons[index]}
            />
          </span>

          <h3 class="mt-5 font-display text-h3 text-text">{service.title}</h3>

          <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-muted">
            {service.description}
          </p>

          <a
            href={whatsappLink(service.message)}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost mt-6 self-start !px-4 !py-2"
          >
            {t.askMe}
            <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 12 12 4M5.5 4H12v6.5"/></svg>
          </a>
        </article>
      </div>
    ))
  }
</div>
