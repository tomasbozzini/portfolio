---
/*
  Foto (opcional). Cuando la tengas:
  1. Guardala en src/assets/foto.jpg (cuadrada, al menos 600x600).
  2. Descomentá el import y el bloque <div class="hidden sm:block ..."> de abajo.

  import { Image } from 'astro:assets';
  import foto from '../assets/foto.jpg';
*/

import { getLang, ui } from '../i18n/ui';

const t = ui[getLang(Astro.currentLocale)];
const { paragraphs, facts } = t.about;
---

<div class="glass rounded-3xl p-6 sm:p-8 lg:p-10" data-reveal>
  <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:gap-14">
    {/*
    <div class="w-40 shrink-0">
      <Image
        src={foto}
        alt="Tomás Bozzini"
        widths={[160, 320]}
        sizes="160px"
        class="aspect-square w-40 rounded-3xl object-cover"
      />
    </div>
    */}

    <div class="measure flex-1 text-[1.0625rem] leading-relaxed text-muted">
      {paragraphs.map((text, index) => <p class:list={[index > 0 && 'mt-4']}>{text}</p>)}
    </div>

    <dl class="grid gap-3 sm:grid-cols-2 lg:w-80 lg:grid-cols-1">
      {
        facts.map((fact) => (
          <div class="rounded-2xl border border-line bg-ink/40 px-4 py-3">
            <dt class="eyebrow">{fact.label}</dt>
            <dd class="mt-1 text-sm text-text">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</div>
