---
import { site, nav, contact, whatsappLink, generalMessage } from '../config/site';
import TechLogo from './TechLogo.astro';

// Botones de redes. LinkedIn solo aparece si está cargado en src/config/site.ts.
const socials = [
  { label: 'GitHub', href: contact.github },
  ...(contact.linkedin ? [{ label: 'LinkedIn', href: contact.linkedin }] : []),
];
---

<header class="sticky top-3 z-40 sm:top-4">
  <div class="shell">
    <div
      class="glass flex h-14 items-center justify-between gap-6 rounded-full pr-2 pl-5"
    >
      <a
        href="/"
        aria-label={`${site.name}, inicio`}
        class="flex items-center gap-2.5 font-display text-[0.9375rem] font-semibold tracking-tight text-text transition-colors hover:text-accent"
      >
        <span
          class="grid size-7 place-items-center rounded-full bg-gradient-to-br from-accent to-accent-2 text-[0.65rem] font-bold text-ink-deep"
          aria-hidden="true">TB</span
        >
        <span class="hidden sm:inline">{site.name}</span>
      </a>

      <nav aria-label="Secciones" class="hidden items-center gap-1 md:flex">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class="rounded-full px-4 py-2 font-ui text-sm text-muted transition-colors hover:bg-surface-2 hover:text-text"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-1.5">
        {
          socials.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${social.label} (se abre en otra pestaña)`}
              title={social.label}
              class="grid size-9 place-items-center rounded-full border border-line bg-surface/60 text-text transition-all duration-300 hover:-translate-y-0.5 hover:border-accent hover:text-accent hover:shadow-[0_0_18px_-4px_var(--color-accent)]"
            >
              <TechLogo name={social.label} size={16} mono />
            </a>
          ))
        }

        <a
          href={whatsappLink(generalMessage)}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary ml-1 !px-4 !py-2 !text-[0.8125rem]"
        >
          Escribime
        </a>
      </div>
    </div>
  </div>
</header>
