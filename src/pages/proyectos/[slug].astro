---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import ProjectEmblem from '../../components/ProjectEmblem.astro';
import StackTags from '../../components/StackTags.astro';
import { getProjects, projectHref, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();

  return projects.map((project, index) => ({
    params: { slug: project.data.slug },
    props: {
      project,
      prev: projects[index - 1] ?? null,
      next: projects[index + 1] ?? null,
    },
  }));
}

interface Props {
  project: Project;
  prev: Project | null;
  next: Project | null;
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const { title, category, status, summary, stack, cover, gallery, links, emblem } = project.data;
const hasLinks = Boolean(links.repo || links.demo);
---

<Base title={title} description={summary} ogType="article">
  <article class="shell pt-12 pb-8 lg:pt-16">
    <a
      href="/#proyectos"
      class="btn-ghost !px-4 !py-2 !text-meta"
    >
      Volver a proyectos
    </a>

    <header class="mt-8 max-w-4xl">
      <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1">
        <span class="font-ui text-meta text-muted">{category}</span>
        {status && <span class="font-ui text-meta text-accent">{status}</span>}
      </div>

      <h1 class="mt-4 font-display text-[clamp(2rem,5.5vw,3.5rem)] leading-[1.02] tracking-tight text-text">
        {title}
      </h1>

      <p class="measure mt-6 font-body text-lg leading-relaxed text-muted">
        {summary}
      </p>
    </header>

    <div class="glass relative mt-12 aspect-16/9 overflow-hidden rounded-3xl p-2 lg:aspect-[21/9] [&>*]:rounded-[1.1rem]">
      {/* Con emblema y sin captura propia, el fondo va liso: solo el logo, sin el patrón generado. */}
      {
        (cover || !emblem) && (
          <ProjectCover
            cover={cover}
            title={title}
            category={category}
            slug={project.data.slug}
            sizes="(min-width: 1280px) 1216px, 100vw"
            eager
            instance="portada"
          />
        )
      }
      <ProjectEmblem emblem={emblem} size="lg" />
    </div>

    <div class="mt-14 grid gap-14 lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-16">
      <div class="prose measure">
        <Content />
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        <h2 class="font-display text-h3 text-text">Stack</h2>
        <div class="mt-4">
          <StackTags items={stack} />
        </div>

        {
          hasLinks && (
            <div class="mt-10">
              <h2 class="font-display text-h3 text-text">Enlaces</h2>
              <ul class="mt-4 flex flex-col items-start gap-3">
                {links.demo && (
                  <li>
                    <a
                      href={links.demo}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-ghost !px-4 !py-2"
                    >
                      Ver el sitio
                    </a>
                  </li>
                )}
                {links.repo && (
                  <li>
                    <a
                      href={links.repo}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-ghost !px-4 !py-2"
                    >
                      Ver el código
                    </a>
                  </li>
                )}
              </ul>
            </div>
          )
        }
      </aside>
    </div>

    <section class="mt-20">
      <h2 class="font-display text-h3 text-text">Capturas</h2>

      {
        gallery.length > 0 ? (
          <ul class="mt-6 grid gap-6 sm:grid-cols-2">
            {gallery.map((shot) => (
              <li class="glass overflow-hidden rounded-3xl p-2">
                <Image
                  src={shot.src}
                  alt={shot.alt}
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 640px) 45vw, 100vw"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full rounded-[1.1rem] object-cover"
                />
              </li>
            ))}
          </ul>
        ) : (
          <p class="measure mt-4 font-body text-muted">
            Todavía no cargué capturas de este proyecto.
          </p>
        )
      }
    </section>

    <nav
      aria-label="Otros proyectos"
      class="mt-20 grid gap-4 sm:grid-cols-2"
    >
      {
        prev ? (
          <a href={projectHref(prev.data.slug)} class="glass glow-edge group rounded-3xl p-6 transition-transform duration-300 hover:-translate-y-1">
            <span class="font-ui text-meta text-muted">Proyecto anterior</span>
            <span class="mt-2 block font-display text-[1.0625rem] leading-tight text-text transition-colors group-hover:text-accent">
              {prev.data.title}
            </span>
          </a>
        ) : (
          <span class="hidden sm:block" />
        )
      }

      {
        next ? (
          <a
            href={projectHref(next.data.slug)}
            class="glass glow-edge group rounded-3xl p-6 transition-transform duration-300 hover:-translate-y-1 sm:text-right"
          >
            <span class="font-ui text-meta text-muted">Proyecto siguiente</span>
            <span class="mt-2 block font-display text-[1.0625rem] leading-tight text-text transition-colors group-hover:text-accent">
              {next.data.title}
            </span>
          </a>
        ) : (
          <span class="hidden sm:block" />
        )
      }
    </nav>
  </article>
</Base>
