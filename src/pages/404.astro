---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada" description="Esta dirección no existe en el sitio.">
  <section class="shell py-24 lg:py-32">
    <h1 class="font-display text-[clamp(2rem,5.5vw,3.5rem)] leading-tight text-text">
      Esta página no existe
    </h1>

    <p class="measure mt-5 font-body text-lg text-muted">
      Puede que el enlace esté viejo o que haya cambiado el nombre del proyecto.
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
      <a
        href="/"
        class="btn-primary"
      >
        Ir al inicio
      </a>
      <a
        href="/#proyectos"
        class="btn-ghost"
      >
        Ver los proyectos
      </a>
    </div>
  </section>
</Base>
