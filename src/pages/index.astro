---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import ProjectGrid from '../components/ProjectGrid';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import StackSection from '../components/StackSection.astro';
import Contact from '../components/Contact.astro';
import { getProjects, toCard } from '../lib/projects';
import { categories } from '../config/site';

const projects = await getProjects();
const featured = projects.filter((project) => project.data.featured);
const cards = await Promise.all(projects.map(toCard));
---

<Base>
  <Hero />

  <div class="shell">
    <div class="spine">
      <section id="proyectos" class="py-16 lg:py-20">
        <SectionHeading eyebrow="01 / Trabajo" title="Proyectos destacados" />
        <FeaturedProjects projects={featured} />
      </section>

      <section id="todos" class="py-16 lg:py-20">
        <SectionHeading eyebrow="02 / Archivo" title="Todos los proyectos" />
        <div data-reveal>
          <ProjectGrid projects={cards} categories={categories} client:visible />
        </div>
      </section>

      <section id="servicios" class="py-16 lg:py-20">
        <SectionHeading
          eyebrow="03 / Servicios"
          title="Servicios"
          lead="Tres formas de trabajar juntos. Contame qué necesitás y te digo cómo lo resolvería."
        />
        <Services />
      </section>

      <section id="sobre-mi" class="py-16 lg:py-20">
        <SectionHeading eyebrow="04 / Perfil" title="Sobre mí" />
        <About />
      </section>

      <section id="stack" class="py-16 lg:py-20">
        <SectionHeading
          eyebrow="05 / Tecnologías"
          title="Stack"
          lead="Las herramientas con las que construyo, separadas por capa."
        />
        <StackSection />
      </section>

      <section id="contacto" class="py-16 lg:py-20">
        <SectionHeading
          eyebrow="06 / Hablemos"
          title="Contacto"
          lead="Escribime por donde te quede más cómodo."
        />
        <Contact />
      </section>
    </div>
  </div>
</Base>
